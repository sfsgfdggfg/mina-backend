OPENAI_API_KEY=your_openai_api_key_here
# P2-09 pilot web shell is disabled unless explicitly enabled.
MINAI_WEB_SHELL_ENABLED=0
MINAI_WEB_SESSION_SECRET=
MINAI_WEB_USERS_JSON={}
MINAI_WEB_SESSION_TTL_MINUTES=480
MINAI_WEB_SESSION_IDLE_MINUTES=60
# External owner-only JSON file for self-service password overrides.
MINAI_WEB_PASSWORD_OVERRIDES_PATH=/data/auth/web-password-overrides.json

# Controlled cloud-pilot transport/persistence (real values stay outside Git).
MINAI_PILOT_EDGE_HTTPS=0
MINAI_PILOT_AIR_WORKSPACE_ENABLED=0
MINAI_CLOUD_STORAGE_ROOT=/data

# Optional provider-neutral IMAP mailbox onboarding.
# Generate MINAI_MAILBOX_CREDENTIAL_KEY as deployment-owned Fernet key.
# Never put an agency mailbox password in this env file.
MINAI_MAILBOX_PROVIDER=auto
MINAI_MAILBOX_CREDENTIAL_KEY=
MINAI_MAILBOX_CREDENTIAL_PATH=/data/auth/mailbox-credentials.enc
# Optional non-secret IMAP setup defaults. Port defaults to 993; username defaults
# to mailbox email; absent host falls back conservatively to mail.<email-domain>.
MINAI_IMAP_DEFAULT_HOST=
MINAI_IMAP_DEFAULT_PORT=993
MINAI_IMAP_DEFAULT_USERNAME=
MINAI_IMAP_DEFAULT_CERTIFICATE_SHA256=

OPENAI_API_KEY=your_openai_api_key_here
# P2-09 pilot web shell is disabled unless explicitly enabled.
MINAI_WEB_SHELL_ENABLED=0
MINAI_WEB_SESSION_SECRET=
MINAI_WEB_USERS_JSON={}
MINAI_WEB_SESSION_TTL_MINUTES=480
MINAI_WEB_SESSION_IDLE_MINUTES=60

# Controlled cloud-pilot transport/persistence (real values stay outside Git).
MINAI_PILOT_EDGE_HTTPS=0
MINAI_CLOUD_STORAGE_ROOT=/data
